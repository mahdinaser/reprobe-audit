+"""REPROBE manifest emitter for SWE-agent.
+
+Single-function module. Call emit_manifest() at the end of each
+task run. Writes <out_dir>/<result_id>.reprobe.json.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+from datetime import date
+from hashlib import sha256
+from pathlib import Path
+
+
+def _container_digest() -> str | None:
+    digest = os.environ.get("REPROBE_CONTAINER_DIGEST")
+    if digest:
+        return digest
+    # Fall back: inspect the running container if Docker is available.
+    try:
+        cid = subprocess.check_output(
+            ["cat", "/etc/hostname"], text=True
+        ).strip()
+        info = subprocess.check_output(
+            ["docker", "inspect", "--format={{.Image}}", cid],
+            text=True, stderr=subprocess.DEVNULL,
+        ).strip()
+        return info if info.startswith("sha256:") else None
+    except Exception:
+        return None
+
+
+def _prompt_hash(system_prompt: str | None) -> str:
+    if not system_prompt:
+        return ""
+    return "sha256:" + sha256(system_prompt.encode()).hexdigest()
+
+
+def emit_manifest(
+    out_dir: Path,
+    result_id: str,
+    *,
+    benchmark: str,
+    benchmark_version: str,
+    subset_cardinality: int,
+    scaffold: str,
+    scaffold_version: str,
+    tools: list[str],
+    max_steps: int,
+    model_alias: str,
+    sampling: str,
+    temperature: float | None,
+    usage: dict,
+    failures: dict[str, int],
+    score: float,
+    system_prompt: str | None = None,
+) -> Path:
+    manifest = {
+        "reprobe_version": "0.1",
+        "result_id": result_id,
+        "identity": {
+            "benchmark": benchmark,
+            "version": benchmark_version,
+            "commit": None,
+            "subset": "full",
+            "subset_rule": None,
+            "cardinality": subset_cardinality,
+            "grader_version": benchmark_version,
+            "partial_credit": False,
+        },
+        "harness": {
+            "scaffold": scaffold,
+            "scaffold_version": scaffold_version,
+            "system_prompt": None,
+            "system_prompt_hash": _prompt_hash(system_prompt),
+            "tools": tools,
+            "max_steps": max_steps,
+            "max_tokens": None,
+            "max_wallclock_seconds": None,
+            "container_digest": _container_digest() or "",
+            "container_tag": None,
+        },
+        "inference": {
+            "provider": "anthropic" if model_alias.startswith("claude") else "openai",
+            "model_alias": model_alias,
+            "engine": None,
+            "sampling": sampling,
+            "temperature": temperature,
+            "top_p": None, "top_k": None,
+            "frequency_penalty": None, "presence_penalty": None,
+            "max_output_tokens": None,
+            "seed": None,
+            "passes_per_task": 1,
+            "aggregation": None,
+            "verifier_for_best_of_n": None,
+            "run_date": date.today().isoformat(),
+        },
+        "cost": {
+            "input_tokens": usage.get("input_tokens"),
+            "output_tokens": usage.get("output_tokens"),
+            "tool_calls": usage.get("tool_calls"),
+            "wallclock_seconds": usage.get("wallclock_seconds"),
+            "dollar_cost_usd": usage.get("dollar_cost_usd"),
+            "rate_source": usage.get("rate_source"),
+        },
+        "failures": failures or None,
+        "headline_metric": {"name": "resolved", "value": score},
+    }
+    out_path = Path(out_dir) / f"{result_id}.reprobe.json"
+    out_path.write_text(json.dumps(manifest, indent=2))
+    return out_path
